<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for power automations & in-app updates -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Package visibility for Shizuku Manager on Android 11+ -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".AutoroidApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Autoroid">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Autoroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Settings Tile: Bank Mode (Accessibility Killer) -->
        <service
            android:name=".feature.tiles.BankModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_shield"
            android:label="@string/tile_bank_mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile: SIM Data Switcher -->
        <service
            android:name=".feature.tiles.SimSwitchTileService"
            android:exported="true"
            android:icon="@drawable/ic_sim_card"
            android:label="@string/tile_sim_switch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- FileProvider for APK update installation fallback -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku Provider: Required for IPC binder token exchange with Shizuku server -->
        <provider
            android:name=".core.privilege.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Receivers for Scheduled SIM Switcher -->
        <receiver
            android:name=".feature.telephony.schedule.receiver.SimScheduleReceiver"
            android:exported="false" />

        <receiver
            android:name=".feature.telephony.schedule.receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

    <instrumentation
        android:name=".feature.telephony.ims.privileged.ImsModifier"
        android:label="Autoroid IMS Modifier"
        android:targetPackage="${applicationId}" />

    <instrumentation
        android:name=".feature.telephony.ims.privileged.BrokerInstrumentation"
        android:label="Autoroid IMS Broker"
        android:targetPackage="${applicationId}" />

    <instrumentation
        android:name=".feature.telephony.ims.privileged.ImsResetter"
        android:label="Autoroid IMS Resetter"
        android:targetPackage="${applicationId}" />

    <instrumentation
        android:name=".feature.telephony.ims.privileged.ImsCapabilityReader"
        android:label="Autoroid IMS Capability Reader"
        android:targetPackage="${applicationId}" />

</manifest>
